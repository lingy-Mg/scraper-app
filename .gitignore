# 依赖与构建产物
node_modules/
dist/
dist-ssr/
*.local
*.tsbuildinfo

# 旧目录：v0.1 曾把运行时数据放在 server/data，迁移后不应再产生
server/data/

# 运行时数据：含 AI Key / TMDB Key / Bangumi Token / 媒体库 / 封面缓存
# 统一放在项目根目录 data/，不写入任何用户目录
data/

# 项目内临时目录（check 的 TEMP/TMP 指向这里，规避系统 TEMP 权限问题）
.tmp/

# 密钥与本地配置
.env
.env.*
*.pem
*.key
!*.key.example

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
*.tmp
